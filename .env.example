# Não use NEXT_PUBLIC_ para nenhuma destas chaves.
# Desenvolvimento local: mantenha os dois campos Turso vazios.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=data/sanctum.db
# Execute npm run configure para gerar uma chave local aleatória.
SETUP_KEY=
APP_URL=http://localhost:3000
# Header X-HOTMART-HOTTOK informado pela Hotmart.
HOTMART_HOTTOK=
# Opcional, mas necessário para primeiro acesso automático.
RESEND_API_KEY=
EMAIL_FROM=
